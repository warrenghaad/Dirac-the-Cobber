modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "manifest"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "librarian-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-server-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lib-watch"

[[workflows.workflow]]
name = "manifest"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run validate:manifest"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "librarian-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/wireframe-librarian run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-server-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "lib-watch"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run dev:libs"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
